      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"[Body] No SOAP Fault in response\", function () {",
              "    const text = pm.response.text();",
              "    pm.expect(text).to.not.include(\"soap:Fault\");",
              "    pm.expect(text).to.not.include(\"faultcode\");",
              "    pm.expect(text).to.not.include(\"faultstring\");",
              "});",
              "",
              "pm.test(\"[Body] Response time < 200ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(200);",
              "});",
              "",
              "pm.test(\"[Header] Server header is present\", function () {",
              "    pm.response.to.have.header(\"Server\");",
              "});",
              "",
              "pm.test(\"[Header] Date is present and parseable\", function () {",
              "    pm.response.to.have.header(\"Date\");",
              "    const d = new Date(pm.response.headers.get(\"Date\"));",
              "    pm.expect(d.toString()).to.not.eql(\"Invalid Date\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
