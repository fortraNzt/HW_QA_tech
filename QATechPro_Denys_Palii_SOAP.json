  "item": [
    {
      "name": "IsValidISBN10",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"[Body] Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"[Body] Response contains SOAP Envelope\", function () {",
              "    const text = pm.response.text();",
              "    pm.expect(text).to.include(\"soap:Envelope\");",
              "    pm.expect(text).to.include(\"xmlns:soap\");",
              "});",
              "",
              "pm.test(\"[Body] Response contains SOAP Body\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"soap:Body\");",
              "});",
              "",
              "pm.test(\"[Header] Content-Type is present\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "});",
              "",
              "pm.test(\"[Header] Content-Type contains 'text/xml'\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");",
              "});",
              "",
              "pm.test(\"[Header] Content-Length is present\", function () {",
              "    pm.response.to.have.header(\"Content-Length\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8",
            "type": "text"
          },
          {
            "key": "SOAPAction",
            "value": "\"\"",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN10 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>{{isbn10_valid}}</sISBN>\n    </IsValidISBN10>\n  </soap:Body>\n</soap:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      },
      "response": []
    },
    {
